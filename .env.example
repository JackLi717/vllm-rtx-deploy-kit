# ===============================
# 🌱 基础配置 - 可复制为 .env 使用
# ===============================

# Conda 环境名称（建议保持与 README 一致）
ENV_NAME=vllm-env

# 模型路径（AWQ 量化模型）
MODEL_PATH=/mnt/c/llm/models/deepseek-14b-awq

# 服务端口
PORT=8000

# 最大上下文长度
MAX_LEN=4096

# 显存使用率（0.90 = 90%）
MEM_UTIL=0.90

# 日志路径
LOG_DIR=./logs
LOG_FILE=./logs/vllm.log
